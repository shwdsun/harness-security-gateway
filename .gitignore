# This repository was bootstrapped from a mixed private workspace. Keep its
# public root fail-closed: new top-level paths require an explicit review here.
/*

!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/.dockerignore
!/.gitignore
!/AGENTS.md
!/LICENSE
!/Makefile
!/README.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
!/go.mod
!/go.sum

!/cmd/
!/cmd/**
!/config/
!/config/agentd.example.json
!/config/sandboxd.example.json
!/demo/
!/demo/security/
!/demo/security/**
!/internal/
!/internal/**
!/runners/
!/runners/mock/
!/runners/mock/Dockerfile

!/bakeoff/
!/bakeoff/cases.json
!/bakeoff/result-template.md
!/bakeoff/fixtures/
!/bakeoff/fixtures/prepare.sh

!/docs/
!/docs/access-control.md
!/docs/architecture.md
!/docs/competitive-bakeoff.md
!/docs/connector-protocol.md
!/docs/design-principles.md
!/docs/deployment.md
!/docs/implementation-status.md
!/docs/positioning.md
!/docs/runner-protocol.md
!/docs/runbook.md

# Generated state is forbidden even below an allowed source directory.
**/.DS_Store
**/__pycache__/
**/*.pyc
**/*.sqlite3
**/*.sqlite3-shm
**/*.sqlite3-wal
**/*.test
**/coverage.out
**/.env
**/*.local.json
/bin/
