# Review-only system service template; no install target or automatic restart.
[Unit]
Description=Harness Security Gateway Core
After=hgw-sandboxd.service
ConditionPathExists=/etc/hgw/agentd.json

[Service]
Type=exec
User=hgw-agentd
Group=hgw-agentd
SupplementaryGroups=hgw-local-ipc hgw-sandbox-ipc
UMask=0077
WorkingDirectory=/var/lib/hgw-agentd
Environment=HOME=/nonexistent
ExecStart=/opt/hgw/codex-dev/bin/agentd -config /etc/hgw/agentd.json
NoNewPrivileges=yes
CapabilityBoundingSet=
KillMode=control-group
TimeoutStopSec=90
Restart=no
