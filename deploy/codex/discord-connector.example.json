{
  "schema": "discord-connector/v1",
  "agentd_socket": "/run/hgw/discord/agentd.sock",
  "state_database": "/var/lib/hgw-connector-discord/state/connector.sqlite3",
  "token_file": "/var/lib/hgw-connector-discord/credentials/bot-token",
  "api_base_url": "https://discord.com/api/v10",
